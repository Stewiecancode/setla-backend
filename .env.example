PORT=4000
FRONTEND_ORIGINS=http://localhost:3000
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# Local development: absolute path to a service account JSON kept outside Git.
GOOGLE_APPLICATION_CREDENTIALS=
# Cloud hosting can use Application Default Credentials instead.
# Alternative for hosts accepting environment secrets:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Set only when behind a known single reverse proxy (otherwise leave 0).
TRUST_PROXY=0
